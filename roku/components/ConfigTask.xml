<?xml version="1.0" encoding="utf-8" ?>

<!-- Where the board comes from.

     Resolution order, first hit wins as the *live* board:

       1. remoteUrl  a hosted board.json, if one was baked in or set on the TV
       2. cachefs:/  the last good remote copy, so a dead uplink at 6am still
                     shows yesterday's menu rather than a stale packaged one
       3. pkg:/      the copy exported into the package. Always present.

     The packaged copy is read first and published immediately, so the board is
     on screen before the network is consulted at all. -->

<component name="ConfigTask" extends="Task">
  <interface>
    <field id="remoteUrl" type="string" value="" />
    <field id="config" type="assocarray" />
    <!-- package | cache | remote | sync | pairing -->
    <field id="source" type="string" value="" />
    <field id="error" type="string" value="" />
    <!-- Spots played since the last sync, handed in by the scene; how many
         of them the server took, handed back. -->
    <field id="plays" type="array" />
    <field id="playsAccepted" type="integer" value="0" />
    <!-- What this screen was told about itself from its own remote, for the
         server to write against this device rather than against the board.
         { orientation, turn }; empty until somebody sets it. -->
    <field id="screen" type="assocarray" />
    <!-- What the cache holds: { files, usedMb, totalMb, freeMb }.
         Published because roFileSystem is only usable from this thread on
         some sets, so the scene cannot read the disk for itself. -->
    <field id="cacheState" type="assocarray" />
  </interface>

  <script type="text/brightscript" uri="pkg:/components/ConfigTask.brs" />
</component>
